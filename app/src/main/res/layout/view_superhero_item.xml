<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="@dimen/spacing_vertical"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <ImageView
        android:id="@+id/superhero_iamge"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_width="@dimen/image_xl"
        android:layout_height="@dimen/image_xl"
        android:src="@tools:sample/avatars" />
    <TextView
        android:id="@+id/superhero_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/superhero_iamge"
        app:layout_constraintTop_toTopOf="@id/superhero_iamge"
        android:text="SuperWoman"/>
    <TextView
        android:id="@+id/superhero_slug"
        android:text="super-woman"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_horizontal"
        app:layout_constraintStart_toStartOf="@id/superhero_name"
        app:layout_constraintTop_toBottomOf="@id/superhero_name"/>
        />



</androidx.constraintlayout.widget.ConstraintLayout>